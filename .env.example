# ---- Runtime ----
# Lokasi file SQLite. Default: ./.data/veriflow.db
# Di Vercel (filesystem read-only) set ke /tmp/veriflow.db → data hilang tiap cold start.
VERIFLOW_DB_PATH=./.data/veriflow.db

# Database URL untuk Prisma/Postgres (Neon, Vercel Postgres, Turso, dll).
# Jika diisi, aplikasi akan pakai Prisma Client ke Postgres, bukan SQLite lokal.
# Format: postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL=

# URL publik aplikasi (dipakai untuk signed link report & callback runner)
PUBLIC_BASE_URL=http://localhost:3000

# Umur berlaku signed link report (hari)
REPORT_LINK_TTL_DAYS=14

# ---- Adapter (semua opsional; default = mock deterministik) ----
# LLM: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_PLANNER=claude-sonnet-4-5
LLM_MODEL_GENERATOR=claude-sonnet-4-5
LLM_BUDGET_USD_PER_RUN=2.00

# Git: mock (repo dari fixture lokal) | github (butuh token)
GIT_PROVIDER=mock
GITHUB_PAT=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Email: outbox (ditulis ke DB, tampil di Email Center) | resend | smtp
EMAIL_PROVIDER=outbox
EMAIL_FROM=Veriflow <no-reply@veriflow.dev>
RESEND_API_KEY=
SMTP_URL=

# ---- Runner (opsional: Playwright sungguhan) ----
# none = pakai executor simulasi bawaan | http = panggil runner eksternal
RUNNER_PROVIDER=none
RUNNER_CALLBACK_SECRET=dev-secret-change-me
RUNNER_MAX_PARALLEL=4

# Seed data demo saat DB kosong (false = mulai kosong)
VERIFLOW_SEED=true

# Kecepatan demo: delay antar step (ms). Default 220. Set 10 untuk CI cepat.
VERIFLOW_STEP_DELAY_MS=220