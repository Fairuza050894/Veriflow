// Veriflow Prisma Schema
// Converted from src/lib/schema.sql
// Uses TEXT for UUIDs, JSON stored as TEXT, timestamps as ISO-8601 TEXT

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Neon / Vercel Postgres / Turso
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  createdAt String @map("created_at")
  projects  Project[]

  @@map("organizations")
}

model Project {
  id             String       @id @default(cuid())
  orgId          String @map("org_id")
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  repoProvider   String       @default("github") @map("repo_provider")
  repoUrl        String @map("repo_url")
  defaultBranch  String       @default("main") @map("default_branch")
  subfolder      String?
  mode           String       @default("FULL_AUTO")
  scaffoldRoot   String       @default("autoqa") @map("scaffold_root")
  settings       String       @default("{}") // JSON
  detected       String?      // JSON
  createdAt      String @map("created_at")
  environments   Environment[]
  recipients     Recipient[]
  runs           Run[]
  testStats      TestStat[]

  @@index([orgId])
  @@map("projects")
}

model Environment {
  id              String    @id @default(cuid())
  projectId       String @map("project_id")
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  baseUrl         String @map("base_url")
  apiBaseUrl      String    @default("") @map("api_base_url")
  authStrategy    String    @default("none") @map("auth_strategy")
  readOnly        Int   @default(0) @map("read_only")
  egressAllowlist String? @map("egress_allowlist")
  secretRef       String? @map("secret_ref")
  runs            Run[]

  @@index([projectId])
  @@map("environments")
}

model Recipient {
  id            String   @id @default(cuid())
  projectId     String @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email         String
  kind          String   @default("to") // to, cc, bcc
  locale        String   @default("id")
  verifiedAt    String? @map("verified_at")
  unsubscribedAt String? @map("unsubscribed_at")

  @@map("recipients")
}

model Run {
  id              String     @id @default(cuid())
  projectId       String @map("project_id")
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId   String? @map("environment_id")
  environment     Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  trigger         String     @default("manual")
  commitSha       String     @default("") @map("commit_sha")
  branch          String     @default("main")
  mode            String     @default("FULL_AUTO")
  status          String
  idempotencyKey  String     @unique @map("idempotency_key")
  startedAt       String? @map("started_at")
  finishedAt      String? @map("finished_at")
  summary         String?    // JSON
  cost            String?    // JSON
  reportUrl       String? @map("report_url")
  error           String?
  createdAt       String @map("created_at")
  steps           RunStep[]
  logs            RunLog[]
  testResults     TestResult[]
  emailMessages   EmailMessage[]
  reportLinks     ReportLink[]
  archSnapshots   ArchSnapshot[]
  diagrams        Diagram[]
  nodeCoverage    NodeCoverage[]
  devopsFindings  DevOpsFinding[]
  aiCalls         AiCall[]

  @@index([projectId, createdAt(sort: Desc)])
  @@map("runs")
}

model RunStep {
  id          String   @id @default(cuid())
  runId       String @map("run_id")
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name        String
  status      String   @default("pending")
  attempt     Int      @default(0)
  startedAt   String? @map("started_at")
  finishedAt  String? @map("finished_at")
  detail      String?
  seq         Int      @default(0)

  @@index([runId, seq])
  @@map("run_steps")
}

model RunLog {
  id        Int      @id @default(autoincrement())
  runId     String @map("run_id")
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  step      String
  level     String   @default("info")
  message   String
  ts        String

  @@index([runId])
  @@map("run_logs")
}

model TestResult {
  id              String   @id @default(cuid())
  runId           String @map("run_id")
  run             Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  projectId       String @map("project_id")
  file            String
  title           String
  layer           String   @default("ui")
  tags            String   @default("[]") // JSON
  status          String
  durationMs      Int      @default(0) @map("duration_ms")
  retries         Int      @default(0)
  errorMessage    String? @map("error_message")
  errorCategory   String? @map("error_category")
  promptVersion   String? @map("prompt_version")
  model           String?
  quarantined     Int  @default(0)
  covers          String?  // JSON
  origin          String   @default("ai")

  @@index([runId, status])
  @@index([projectId, status])
  @@map("test_results")
}

model TestStat {
  id                String   @id @default(cuid())
  projectId         String @map("project_id")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file              String
  title             String
  runs              Int      @default(0)
  avgDurationMs     Int      @default(0) @map("avg_duration_ms")
  flakyScore        Float    @default(0) @map("flaky_score")
  consecutiveGreen  Int      @default(0) @map("consecutive_green")
  lastStatus        String   @default("passed") @map("last_status")

  @@unique([projectId, file, title])
  @@map("test_stats")
}

model EmailMessage {
  id              String   @id @default(cuid())
  runId           String? @map("run_id")
  run             Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  kind            String
  toEmail         String @map("to_email")
  subject         String
  status          String   @default("queued")
  attempts        Int      @default(0)
  bodyHtml        String? @map("body_html")
  bodyText        String? @map("body_text")
  idempotencyKey  String   @unique @map("idempotency_key")
  createdAt       String @map("created_at")
  sentAt          String? @map("sent_at")

  @@index([runId])
  @@map("email_messages")
}

model ReportLink {
  id            String   @id @default(cuid())
  runId         String @map("run_id")
  run           Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique @map("token_hash")
  passwordHash  String? @map("password_hash")
  expiresAt     String @map("expires_at")
  revokedAt     String? @map("revoked_at")

  @@map("report_links")
}

model ArchSnapshot {
  id                String   @id @default(cuid())
  projectId         String @map("project_id")
  runId             String? @map("run_id")
  run               Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  commitSha         String @map("commit_sha")
  model             String   // JSON
  nodeCount         Int      @default(0) @map("node_count")
  edgeCount         Int      @default(0) @map("edge_count")
  extractorStatus   String   @default("[]") @map("extractor_status") // JSON
  createdAt         String @map("created_at")
  diagrams          Diagram[]
  findings          ArchFinding[]

  @@index([runId])
  @@map("arch_snapshots")
}

model Diagram {
  id            String       @id @default(cuid())
  snapshotId    String @map("snapshot_id")
  snapshot      ArchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  runId         String @map("run_id")
  run           Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  audience      String       @default("internal")
  syntax        String       @default("mermaid")
  source        String
  nodeCount     Int          @default(0) @map("node_count")
  truncated     Int      @default(0)
  aiSummary     String? @map("ai_summary")
  status        String       @default("ok")
  inEmail       Int      @default(0) @map("in_email")
  altText       String? @map("alt_text")

  @@index([runId])
  @@map("diagrams")
}

model NodeCoverage {
  runId       String @map("run_id")
  nodeId      String @map("node_id")
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind        String
  testsTotal  Int      @default(0) @map("tests_total")
  passed      Int      @default(0)
  failed      Int      @default(0)
  flaky       Int      @default(0)
  state       String   @default("untested")

  @@id([runId, nodeId])
  @@map("node_coverage")
}

model ArchFinding {
  id        String       @id @default(cuid())
  snapshotId String @map("snapshot_id")
  snapshot  ArchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  code      String
  severity  String
  title     String
  detail    String       @default("")
  nodes     String       @default("[]") // JSON
  evidence  String       @default("[]") // JSON

  @@map("arch_findings")
}

model DevOpsFinding {
  id        String   @id @default(cuid())
  runId     String @map("run_id")
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  tool      String
  severity  String
  rule      String
  location  String
  message   String
  fixHint   String? @map("fix_hint")

  @@map("devops_findings")
}

model AiCall {
  id              String   @id @default(cuid())
  runId           String @map("run_id")
  run             Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  step            String
  promptName      String @map("prompt_name")
  promptVersion   String @map("prompt_version")
  model           String
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  costUsd         Float    @default(0) @map("cost_usd")
  latencyMs       Int      @default(0) @map("latency_ms")

  @@index([runId])
  @@map("ai_calls")
}

model PromptVersion {
  id           String   @id @default(cuid())
  name         String
  version      String
  contentHash  String @map("content_hash")
  path         String
  status       String   @default("active")
  createdAt    String @map("created_at")

  @@unique([name, version])
  @@map("prompt_versions")
}

model Kv {
  key        String   @id
  value      String
  updatedAt  String @map("updated_at")

  @@map("kv")
}
