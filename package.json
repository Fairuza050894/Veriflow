{
  "name": "veriflow",
  "version": "0.1.0",
  "private": true,
  "description": "Veriflow — AI-assisted UI + API test automation orchestrator. Connect repo → run → report.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "runner": "node runner/worker.mjs",
    "db:reset": "rm -rf .data && echo 'db reset'"
  },
  "dependencies": {
    "mermaid": "^11.4.1",
    "next": "15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
}
